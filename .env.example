# 복사해서 .env 로 만든 뒤 값을 채운다. 이 파일에는 실제 값을 넣지 않는다.

# --- DB (MySQL 8.0) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fortuna_ball
DB_USER=
DB_PASSWORD=

# --- AI ---
AI_API_KEY=

# --- 지도 · 주소 좌표 변환 (서비스 확정 후 사용) ---
GEOCODE_API_KEY=

# --- 관리자 ---
ADMIN_INITIAL_PASSWORD=

# --- 파일 업로드 (비공개 저장 경로) ---
UPLOAD_DIR=
